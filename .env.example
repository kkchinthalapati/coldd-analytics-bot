# COLDD analytics bot configuration.
# Copy to ".env" (or enter the same names as environment variables in the hosting panel).
# Real environment variables override values in .env. Never commit .env.

# --- Required ---------------------------------------------------------------
DISCORD_TOKEN=paste-your-bot-token-here
GUILD_ID=000000000000000000

# --- Access -----------------------------------------------------------------
# Owner(s): full access incl. data export, history import, member deletion.
# If empty, the Discord server owner is treated as the bot owner.
OWNER_IDS=
# Roles allowed to run staff commands (comma-separated role IDs).
STAFF_ROLE_IDS=
# Also treat members with the "Manage Server" permission as staff.
ALLOW_MANAGE_GUILD=true

# --- Time -------------------------------------------------------------------
# IANA timezone used for days and weeks, e.g. UTC, Europe/London, America/New_York
TIMEZONE=UTC
WEEK_START_DAY=monday

# --- Storage ----------------------------------------------------------------
DATA_DIR=.
DATA_FILE=data.json
SAVE_INTERVAL_SECONDS=60
BACKUP_INTERVAL_HOURS=6
BACKUP_COUNT=5
STORAGE_WARN_MB=25
LOG_DIR=logs
LOG_MAX_KB=1024
LOG_BACKUPS=3

# --- Retention (days) -------------------------------------------------------
MEMBER_RETENTION_DAYS=365
SERVER_RETENTION_DAYS=180
AWARD_RETENTION_DAYS=1095
INACTIVE_MEMBER_RETENTION_DAYS=365

# --- What counts ------------------------------------------------------------
# Channel or category IDs. INCLUDE empty = every channel the bot can read.
INCLUDE_CHANNEL_IDS=
EXCLUDE_CHANNEL_IDS=
# Members with these roles are counted in analytics but cannot win awards.
EXCLUDE_ROLE_IDS=
# Scoring scope. When either is set, only these channels count toward Member of the Week and the /top boards
# (analytics still counts everything). IDs are comma-separated; prefixes match channel names, case-insensitive,
# which suits tickets (they are created and renamed, e.g. ticket-0042 -> closed-0042).
SCORE_CHANNEL_IDS=
SCORE_CHANNEL_PREFIXES=
COUNT_BOTS=false

# --- Collection detail ------------------------------------------------------
# Needs "Message Content Intent" enabled in the Developer Portal. Used ONLY for
# short-lived duplicate fingerprints and staff-requested AI review; text is never saved.
MESSAGE_CONTENT_INTENT=true
DUPLICATE_WINDOW_SECONDS=600
BURST_WINDOW_SECONDS=60
BURST_THRESHOLD=12
RECENT_MESSAGE_CACHE=20000
RECENT_MESSAGE_HOURS=24
VOICE_ENABLED=true
VOICE_MIN_MEMBERS=2
REACTIONS_ENABLED=true

# --- Member of the Week -----------------------------------------------------
AWARD_AMOUNT=150
AWARD_CURRENCY=Robux
WEIGHT_PARTICIPATION=0.30
WEIGHT_CONSISTENCY=0.15
WEIGHT_HELPFULNESS=0.15
WEIGHT_EXTRA=0.10
WEIGHT_CONVERSATION=0.20
WEIGHT_PRESENCE=0.10
DAILY_MESSAGE_CAP=200
DAILY_REPLY_CAP=100
DAILY_REACTION_CAP=200
MIN_WEEKLY_MESSAGES=20
MIN_ACTIVE_DAYS=3
MIN_DAILY_MESSAGES_FOR_ACTIVE=1
WINNER_COOLDOWN_WEEKS=0
SHORTLIST_SIZE=10
SPAM_FLAG_RATIO=0.30
NOMINATION_WEIGHT=5

# --- Reports ----------------------------------------------------------------
AUDIT_MAX_DAYS=180
EXPORT_MAX_ROWS=5000
HISTORY_IMPORT_ENABLED=true
# Re-verify the last N complete days from Discord's history every night (0 = off)
AUTO_RECOUNT_DAYS=3

# --- Optional AI (advisory only; leave blank to disable) -----------------------
# AI_PROVIDER=anthropic   or   openai  (any OpenAI-compatible API via AI_BASE_URL)
# Providers are tried in this order: Gemini, then OpenRouter, then the AI_* provider below. Any may be blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_REQUESTS_PER_DAY=20
AI_MAX_MESSAGES_PER_REQUEST=5
